# Set from a Neon PostgreSQL project. Never commit real credentials.
DATABASE_URL=
# Set a high-entropy token before enabling the private /admin CSV export.
ADMIN_API_TOKEN=
# Set another high-entropy value; if blank, DATABASE_URL is used as the HMAC key.
RATE_LIMIT_SECRET=
# Optional numeric Meta Pixel ID. Leave blank to disable Meta tracking.
VITE_META_PIXEL_ID=
